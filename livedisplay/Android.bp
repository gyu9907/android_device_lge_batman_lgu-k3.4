    name: "vendor.lineage.livedisplay@2.0-service.batman",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    init_rc: ["vendor.lineage.livedisplay@2.0-service.batman.rc"],
