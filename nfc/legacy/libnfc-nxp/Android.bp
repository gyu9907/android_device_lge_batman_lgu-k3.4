// PN544 HCI stack, kept separate from the platform NCI stack.
cc_library_shared {
    name: "libnfc_pn544",
    generated_headers: ["batman_pn544_firmware_header"],
    compile_multilib: "32",
    instruction_set: "arm",
    srcs: [
        "src/phLibNfc.c",
        "src/phLibNfc_discovery.c",
        "src/phLibNfc_initiator.c",
        "src/phLibNfc_llcp.c",
        "src/phLibNfc_Ioctl.c",
        "src/phLibNfc_ndef_raw.c",
        "src/phLibNfc_SE.c",
        "src/phLibNfc_target.c",
        "src/phHal4Nfc_ADD.c",
        "src/phHal4Nfc.c",
        "src/phHal4Nfc_Emulation.c",
        "src/phHal4Nfc_P2P.c",
        "src/phHal4Nfc_Reader.c",
        "src/phDnldNfc.c",
        "src/phHciNfc_AdminMgmt.c",
        "src/phHciNfc.c",
        "src/phHciNfc_CE_A.c",
        "src/phHciNfc_CE_B.c",
        "src/phHciNfc_DevMgmt.c",
        "src/phHciNfc_Emulation.c",
        "src/phHciNfc_Felica.c",
        "src/phHciNfc_Generic.c",
        "src/phHciNfc_IDMgmt.c",
        "src/phHciNfc_ISO15693.c",
        "src/phHciNfc_Jewel.c",
        "src/phHciNfc_LinkMgmt.c",
        "src/phHciNfc_NfcIPMgmt.c",
        "src/phHciNfc_Pipe.c",
        "src/phHciNfc_PollingLoop.c",
        "src/phHciNfc_RFReaderA.c",
        "src/phHciNfc_RFReaderB.c",
        "src/phHciNfc_RFReader.c",
        "src/phHciNfc_Sequence.c",
        "src/phHciNfc_SWP.c",
        "src/phHciNfc_WI.c",
        "src/phLlcNfc.c",
        "src/phLlcNfc_Frame.c",
        "src/phLlcNfc_Interface.c",
        "src/phLlcNfc_StateMachine.c",
        "src/phLlcNfc_Timer.c",
        "src/phFriNfc_Llcp.c",
        "src/phFriNfc_LlcpUtils.c",
        "src/phFriNfc_LlcpTransport.c",
        "src/phFriNfc_LlcpTransport_Connectionless.c",
        "src/phFriNfc_LlcpTransport_Connection.c",
        "src/phFriNfc_LlcpMac.c",
        "src/phFriNfc_LlcpMacNfcip.c",
        "src/phFriNfc_FelicaMap.c",
        "src/phFriNfc_MifareStdMap.c",
        "src/phFriNfc_MifareULMap.c",
        "src/phFriNfc_MapTools.c",
        "src/phFriNfc_TopazMap.c",
        "src/phFriNfc_TopazDynamicMap.c",
        "src/phFriNfc_DesfireMap.c",
        "src/phFriNfc_ISO15693Map.c",
        "src/phFriNfc_NdefMap.c",
        "src/phFriNfc_IntNdefMap.c",
        "src/phFriNfc_NdefReg.c",
        "src/phFriNfc_DesfireFormat.c",
        "src/phFriNfc_MifULFormat.c",
        "src/phFriNfc_MifStdFormat.c",
        "src/phFriNfc_SmtCrdFmt.c",
        "src/phFriNfc_ISO15693Format.c",
        "src/phFriNfc_OvrHal.c",
        "Linux_x86/phOsalNfc_Timer.c",
        "Linux_x86/phOsalNfc.c",
        "Linux_x86/phOsalNfc_Utils.c",
        "Linux_x86/phDal4Nfc_uart.c",
        "Linux_x86/phDal4Nfc.c",
        "Linux_x86/phDal4Nfc_i2c.c",
        "Linux_x86/phDal4Nfc_messageQueueLib.c",
    ],
    local_include_dirs: ["inc", "src", "Linux_x86"],
    export_include_dirs: ["inc", "src"],
    cflags: ["-DNXP_MESSAGING", "-DANDROID", "-DNFC_TIMER_CONTEXT", "-fno-strict-aliasing", "-Wno-unused-parameter"],
    shared_libs: ["libcutils", "libnfc_pn544_ndef", "libdl", "libhardware", "liblog"],
}

cc_library_shared {
    name: "libnfc_pn544_ndef",
    compile_multilib: "32",
    srcs: ["src/phFriNfc_NdefRecord.c"],
    local_include_dirs: ["inc", "src"],
    shared_libs: ["libcutils", "liblog"],
}
