Subject: [PATCH] TWRP: Bound LG misc BCB and use p28 system with p32 data
Target-source-root: twrp-3.7.0-oreo (Android 9 recovery tree)

Limit LG misc access to the first 2048 bytes; reject wipe packages.
Keep calibration bytes and LG factory flags outside the BCB untouched.
Map system to p28 and ext4 data/media to p32 without changing the
partition table. The layout marker permits matching full ROM OTAs.
Existing recovery security configuration is unchanged.

Apply from the TWRP source root with git apply --check, then git apply.
Do not apply this patch to the Android platform recovery repository.

diff --git a/bootable/recovery/bootloader_message/Android.mk b/bootable/recovery/bootloader_message/Android.mk
--- a/bootable/recovery/bootloader_message/Android.mk
+++ b/bootable/recovery/bootloader_message/Android.mk
@@ -26,4 +26,7 @@
 endif
 LOCAL_C_INCLUDES := $(LOCAL_PATH)/include
 LOCAL_EXPORT_C_INCLUDE_DIRS := $(LOCAL_PATH)/include
+ifeq ($(BOARD_MISC_BCB_ONLY),true)
+    LOCAL_CFLAGS += -DBOARD_MISC_BCB_ONLY
+endif
 include $(BUILD_STATIC_LIBRARY)
diff --git a/bootable/recovery/bootloader_message/bootloader_message.cpp b/bootable/recovery/bootloader_message/bootloader_message.cpp
--- a/bootable/recovery/bootloader_message/bootloader_message.cpp
+++ b/bootable/recovery/bootloader_message/bootloader_message.cpp
@@ -70,6 +70,24 @@
   }
   return record->blk_device;
 }
+
+
+#ifdef BOARD_MISC_BCB_ONLY
+static_assert(BOOTLOADER_MESSAGE_OFFSET_IN_MISC == 0,
+              "BCB-only misc requires a zero message offset");
+static_assert(sizeof(bootloader_message) == 2048, "Unexpected BCB size");
+
+// LG stores NV backups and factory flags outside the recovery message. Check
+// before opening the device, with subtraction to avoid offset + size overflow.
+static bool validate_misc_access(size_t offset, size_t size, std::string* err) {
+  constexpr size_t kBcbSize = 2048;
+  if (offset > kBcbSize || size > kBcbSize - offset) {
+    *err = "misc access outside the 2 KiB bootloader message is disabled";
+    return false;
+  }
+  return true;
+}
+#endif
 
 // In recovery mode, recovery can get started and try to access the misc
 // device before the kernel has actually created it.
