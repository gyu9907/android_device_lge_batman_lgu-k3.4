+		// During a FAT-to-data/media transition, vfat is a filesystem label,
+		// not metadata that may be copied onto the new ext4 media directory.
+		// Resolve its intended label from recovery policy before caching it.
+		if (strcmp(selinux_context, "u:object_r:vfat:s0") == 0 &&
+			(strcmp(filename, "/data/media") == 0 ||
+			 strncmp(filename, "/data/media/", 12) == 0)) {
+			struct selinux_opt options[] = {{ SELABEL_OPT_PATH, "/file_contexts" }};
+			struct selabel_handle* media_handle = selabel_open(SELABEL_CTX_FILE, options, 1);
+			char* media_context = NULL;
+			if (media_handle &&
+				selabel_lookup(media_handle, &media_context, filename, S_IFDIR) == 0) {
+				freecon(selinux_context);
+				selinux_context = media_context;
+				// Correct an already converted filesystem too. FAT may reject
+				// this, but the policy label remains valid for later recreation.
+				lsetfilecon(filename, selinux_context);
+			}
+			if (media_handle)
+				selabel_close(media_handle);
+		}
 		printf("tw_get_context got selinux context: %s\n", selinux_context);
