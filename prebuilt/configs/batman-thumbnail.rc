# Loaded by mount_all before media services start. Keep the existing legacy
# shims and select the device retriever only in libmediaplayerservice.
# Init sorts this directory and keeps the first service definition.
# This device-specific media service precedes mediaserver.rc; preserve its
# options while preloading the retriever before libstagefright is resolved.
service media /system/bin/mediaserver
    class main
    user media
    group audio camera inet net_bt net_bt_admin net_bw_acct drmrpc mediadrm
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks /dev/stune/foreground/tasks
    setenv LD_PRELOAD /system/lib/libshim_thumbnail.so

on post-fs-data
    export LD_SHIM_LIBS "/system/lib/hw/camera.vendor.msm8660.so|libshim_camera.so:/system/lib/libOmxVenc.so|libshim_omx_venc.so:/system/lib/libOmxVdec.so|libshim_omx_vdec.so:/system/lib/libmediaplayerservice.so|libshim_thumbnail.so"
