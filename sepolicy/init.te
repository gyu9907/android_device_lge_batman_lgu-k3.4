
allow init tmpfs:lnk_file create;
allow init camera_socket:sock_file relabelto;
allow init serial_device:chr_file getattr;
# libselinux checks the supported filesystem list during initialization.
allow init proc_filesystems:file getattr;

# Existing boot actions signal HDMI readiness and select subsystem restart mode.
allow init sysfs_batman_boot_control:file { w_file_perms setattr };
allow init sysfs_batman_init_control:file setattr;
allow init { sysfs_bluetooth_writable sysfs_wlan_fwpath sysfs_batman_usb_state
             sysfs_batman_modem_transport sysfs_mpdecision proc_bluetooth_writable }:file setattr;

allow init { sysfs_graphics sysfs_hwaddrs_ready sysfs_batman_bt_addr sysfs_batman_wifi_addr
             sysfs_batman_usb_state sysfs_batman_modem_transport }:file getattr;

# Preserve the existing kcal ownership/mode for the LiveDisplay HAL.
allow init sysfs_livedisplay_tuneable:file setattr;
