
# Only the service payloads need legacy executable mappings. The entrypoint
# wrappers remain exec_type and never require execmod themselves.
allow { sensors cnd mpdecision netmgrd batman_kickstart batman_qmiproxy
        qmuxd tee rmt_storage thermal-engine time_daemon batman_bridgemgrd
        port-bridge mm-qcamerad } system_file:file { execute_no_trans execmod };
allow { audioserver cameraserver mediaserver system_server rild } system_file:file execmod;
