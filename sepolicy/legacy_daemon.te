# The normal /system/bin entrypoints establish each service domain before
# executing its PIC vendor payload. No text-relocation exception is needed.
allow { sensors cnd mpdecision netmgrd batman_kickstart batman_qmiproxy
        qmuxd tee rmt_storage thermal-engine time_daemon batman_bridgemgrd
        port-bridge mm-qcamerad } vendor_file:file execute_no_trans;
