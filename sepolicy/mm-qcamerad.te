
# pyramid 8f3f4d9: the msm8660 camera daemon uses cam_socket0.
type_transition mm-qcamerad system_data_file:sock_file camera_socket "cam_socket0";
type_transition mm-qcamerad system_data_file:sock_file camera_socket "cam_socket1";
allow mm-qcamerad camera_socket:sock_file create_file_perms;
allow mm-qcamerad system_data_file:dir { write add_name remove_name };
allow mm-qcamerad { camera_device video_device }:chr_file rw_file_perms;
allow mm-qcamerad camera_device:dir r_dir_perms;
allow mediaserver mm-qcamerad:unix_dgram_socket sendto;
# This device uses the HAL1 passthrough provider inside mediaserver.
allow mediaserver camera_socket:sock_file write;
allow mediaserver camera_device:chr_file rw_file_perms;
