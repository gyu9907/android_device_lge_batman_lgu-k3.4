
# RPC router plus program endpoints used by the legacy modem libraries.
allow { rild time_daemon thermal-engine system_server } batman_oncrpc_dir:dir r_dir_perms;
allow { rild time_daemon thermal-engine system_server } { batman_rpc_device batman_nv_device }:chr_file rw_file_perms;
allow { time_daemon thermal-engine } { diag_device smem_log_device }:chr_file rw_file_perms;
