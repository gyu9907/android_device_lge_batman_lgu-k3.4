cc_binary {
    name: "android.hardware.usb@1.0-service.batman",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.usb@1.0-service.batman.rc"],
    vintf_fragments: ["android.hardware.usb@1.0-service.batman.xml"],
    srcs: ["Usb.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libbase", "libcutils", "libhidlbase", "libutils", "liblog", "android.hardware.usb@1.0"],
}
